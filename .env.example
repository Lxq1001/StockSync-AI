# Local development only: copy this file to .env.local in the repository root.
# Never commit .env.local or share an app password.
STOCKSYNC_EMAIL_ENABLED=true
STOCKSYNC_EMAIL_TRANSPORT=smtp
STOCKSYNC_SMTP_USER=your-store@gmail.com
# Use a Google App Password, NOT your normal Gmail password.
STOCKSYNC_SMTP_APP_PASSWORD=replace-with-your-google-app-password
# Approve only real supplier emails already present in suppliers.json.
STOCKSYNC_SUPPLIER_RECIPIENTS_JSON={"S1":"approved-supplier@example.com"}
